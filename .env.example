# Copie este arquivo para .env e preencha os valores.
# Formato: CHAVE=valor (sem aspas e sem espaços em volta do =).
# Nunca envie o .env para o GitHub nem mostre em prints.

# --- Discord (opcional: só para receber a build no canal) ---
# Discord > Configurações do canal > Integrações > Webhooks > Novo webhook > Copiar URL do webhook
DISCORD_WEBHOOK_URL=

# --- Monitor de partida (app.py) ---
# Rota da build enviada ao Discord: top, jungle, mid, adc ou support
BUILD_ROLE=mid
# Patch das builds do catálogo (data/builds.json). Deixe "geral" para usar as referências iniciais.
BUILD_PATCH=geral
# Intervalo, em segundos, entre as consultas ao jogo
POLL_SECONDS=5

# --- Certificado da Riot (necessário para falar com o cliente do LoL) ---
# Baixe em https://static.developer.riotgames.com/docs/lol/riotgames.pem e salve na pasta do projeto.
RIOT_CA_FILE=riotgames.pem

# --- Opcional (Windows) ---
# Caminho completo do lockfile do LoL, só se o painel não achar o cliente sozinho.
# Exemplo: C:\Riot Games\League of Legends\lockfile
LOL_LOCKFILE=

# --- Opcional: importar partidas da Riot (winrates.py) ---
# Gere em https://developer.riotgames.com (a chave de desenvolvimento expira a cada 24 h).
RIOT_API_KEY=
